___TESTS___

setup: |-
  const pushed = [];
  mock('createQueue', function () { return function (o) { pushed.push(o); }; });
  const cookies = {};
  mock('getCookieValues', function (n) { return cookies[n] ? [cookies[n]] : []; });
scenarios:
- name: A clean page passes
  code: |-
    mock('copyFromWindow', [['consent', 'default', {}], {event: 'gtm.js'}, ['config', 'G-TEST']]);
    mock('isConsentGranted', false);
    runCode({pushEvent: true, eventName: 'consent_check'});
    assertThat(pushed[0].consent_check_status).isEqualTo('ok');
    assertThat(pushed[0].consent_check_issues).isEqualTo('');
    assertApi('gtmOnSuccess').wasCalled();
- name: No consent default is reported, and cookies count as unconsented
  code: |-
    mock('copyFromWindow', [{event: 'gtm.js'}]);
    mock('isConsentGranted', true);
    cookies._ga = 'GA1.1.1.1';
    runCode({pushEvent: true, eventName: 'consent_check'});
    assertThat(pushed[0].consent_check_issues).isEqualTo('no_consent_default,analytics_cookie_without_consent:_ga');
    assertThat(pushed[0].consent_analytics_storage).isEqualTo('not_set');
- name: An unreadable dataLayer is reported, and consent comes from Tag Manager
  code: |-
    mock('copyFromWindow', undefined);
    mock('isConsentGranted', true);
    cookies._ga = 'GA1.1.1.1';
    runCode({pushEvent: true, eventName: 'consent_check'});
    assertThat(pushed[0].consent_check_issues).isEqualTo('datalayer_unreadable');
    assertThat(pushed[0].consent_analytics_storage).isEqualTo('granted');
    assertApi('gtmOnSuccess').wasCalled();
- name: Unreadable entries make a missing default unverified, not missing
  code: |-
    mock('copyFromWindow', [undefined, {event: 'gtm.js'}]);
    mock('isConsentGranted', true);
    cookies._ga = 'GA1.1.1.1';
    runCode({pushEvent: true, eventName: 'consent_check'});
    assertThat(pushed[0].consent_check_issues).isEqualTo('consent_default_unverified');
    assertThat(pushed[0].consent_analytics_storage).isEqualTo('granted');
- name: A gtag config before the default is reported
  code: |-
    mock('copyFromWindow', [['js', {}], ['config', 'G-TEST'], ['consent', 'default', {}]]);
    mock('isConsentGranted', false);
    runCode({pushEvent: true, eventName: 'consent_check'});
    assertThat(pushed[0].consent_check_issues).isEqualTo('gtag_command_before_consent_default');
- name: Cookies without consent are reported
  code: |-
    mock('copyFromWindow', [['consent', 'default', {}]]);
    mock('isConsentGranted', false);
    cookies._ga = 'GA1.1.1.1';
    cookies._fbp = 'fb.1.1.1';
    runCode({pushEvent: true, eventName: 'consent_check'});
    assertThat(pushed[0].consent_check_issues).isEqualTo('analytics_cookie_without_consent:_ga,ad_cookie_without_consent:_fbp');
    assertThat(pushed[0].consent_check_status).isEqualTo('issues');
- name: Cookies are fine once consent is granted
  code: |-
    mock('copyFromWindow', [['consent', 'default', {}]]);
    mock('isConsentGranted', true);
    cookies._ga = 'GA1.1.1.1';
    cookies._gcl_au = '1.1.1';
    runCode({pushEvent: true, eventName: 'consent_check'});
    assertThat(pushed[0].consent_check_status).isEqualTo('ok');
    assertThat(pushed[0].consent_ad_storage).isEqualTo('granted');
- name: No event is pushed when the setting is off
  code: |-
    mock('copyFromWindow', [['consent', 'default', {}]]);
    mock('isConsentGranted', false);
    runCode({pushEvent: false});
    assertThat(pushed.length).isEqualTo(0);
    assertApi('logToConsole').wasCalled();
    assertApi('gtmOnSuccess').wasCalled();


