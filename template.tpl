___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const copyFromWindow = require('copyFromWindow');
const createQueue = require('createQueue');
const isConsentGranted = require('isConsentGranted');
const getCookieValues = require('getCookieValues');
const logToConsole = require('logToConsole');
const getType = require('getType');

const ANALYTICS_COOKIES = ['_ga'];
const AD_COOKIES = ['_gcl_au', '_gcl_aw', '_gcl_dc', '_fbp', '_fbc', '_uetsid', '_uetvid', 'li_fat_id', '_ttp', '_pin_unauth', '_scid'];
const issues = [];

// 1. Is there a Consent Mode default, and does it come before any gtag config or event command?
// copyFromWindow returns undefined if the dataLayer can't be copied; say so rather than guess.
const dl = copyFromWindow('dataLayer');
let defaultAt = -1;
let firstCommandAt = -1;
let noDefault = false;
if (getType(dl) !== 'array') {
  issues.push('datalayer_unreadable');
} else {
  // Entries Tag Manager can't copy come through as undefined. If any are missing, a default
  // may be among them, so it's reported as unverified rather than missing.
  let unreadable = 0;
  for (let i = 0; i < dl.length; i++) {
    const entry = dl[i];
    if (entry === undefined || entry === null) { unreadable++; continue; }
    if (entry[0] === 'consent' && entry[1] === 'default' && defaultAt === -1) defaultAt = i;
    if ((entry[0] === 'config' || entry[0] === 'event') && firstCommandAt === -1) firstCommandAt = i;
  }
  if (defaultAt === -1 && unreadable > 0) issues.push('consent_default_unverified');
  else if (defaultAt === -1) { issues.push('no_consent_default'); noDefault = true; }
  else if (firstCommandAt > -1 && firstCommandAt < defaultAt) issues.push('gtag_command_before_consent_default');
}

// 2. Are there analytics or advertising cookies without the matching consent?
// isConsentGranted treats a consent type that was never set as granted, so when the dataLayer
// shows no default at all, cookies count as set without consent.
const analytics = noDefault ? false : isConsentGranted('analytics_storage');
const ads = noDefault ? false : isConsentGranted('ad_storage');
const stateOf = function (granted) {
  if (noDefault) return 'not_set';
  return granted ? 'granted' : 'denied';
};
const present = function (name) {
  const values = getCookieValues(name);
  return values && values.length > 0;
};
if (!analytics) {
  for (let i = 0; i < ANALYTICS_COOKIES.length; i++) {
    if (present(ANALYTICS_COOKIES[i])) issues.push('analytics_cookie_without_consent:' + ANALYTICS_COOKIES[i]);
  }
}
if (!ads) {
  for (let i = 0; i < AD_COOKIES.length; i++) {
    if (present(AD_COOKIES[i])) issues.push('ad_cookie_without_consent:' + AD_COOKIES[i]);
  }
}

const status = issues.length ? 'issues' : 'ok';
logToConsole('Consent check (Metric Owl): ' + (issues.length ? issues.join(', ') : 'no issues found'),
  {analytics_storage: stateOf(analytics), ad_storage: stateOf(ads)});

if (data.pushEvent) {
  const dataLayerPush = createQueue('dataLayer');
  dataLayerPush({
    event: data.eventName || 'consent_check',
    consent_check_status: status,
    consent_check_issues: issues.join(','),
    consent_analytics_storage: stateOf(analytics),
    consent_ad_storage: stateOf(ads)
  });
}
data.gtmOnSuccess();


